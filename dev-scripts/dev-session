#!/usr/bin/env bash
#
# Two-pane tmux session: shell on the left, Claude Code on the right.
# Usage: dev-session [session-name] [directory]

set -euo pipefail

session_name() {
    local project branch
    project=$(basename "$PWD")
    branch=$(git branch --show-current 2>/dev/null || true)
    case $branch in
        ""|main|master|develop) printf '%s' "$project" ;;
        *)                      printf '%s-%s' "$project" "$branch" ;;
    esac
}

# tmux rejects '.' and ':' in session names; '/' is flattened for readability.
sanitize() { printf '%s' "$1" | tr '/:.' '---'; }

work_dir=${2:-$PWD}
[[ -d $work_dir ]] || { printf 'dev-session: no such directory: %s\n' "$work_dir" >&2; exit 1; }
cd "$work_dir"
session=$(sanitize "${1:-$(session_name)}")

attach() {
    if [[ -n ${TMUX:-} ]]; then
        exec tmux switch-client -t "=$session"
    else
        exec tmux attach-session -t "=$session"
    fi
}

if tmux has-session -t "=$session" 2>/dev/null; then
    attach
fi

tmux new-session -d -s "$session" -n dev -c "$work_dir"
tmux split-window -h -t "=$session:dev" -c "$work_dir"
tmux send-keys -t "=$session:dev.{right}" claude C-m
tmux select-pane -t "=$session:dev.{left}"
attach
