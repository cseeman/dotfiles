#!/usr/bin/env bash
#
# One two-pane tmux session per worktree: shell on the left, Claude Code on the
# right. Named after the directory, so the name stays true when the branch moves.
# Usage: dev-session [session-name] [directory]

set -euo pipefail

die() { printf 'dev-session: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '3,5p' "$0" | sed 's/^# //'; }

case ${1:-} in
    -h|--help) usage; exit 0 ;;
    -*)        usage >&2; die "unknown option: $1" ;;
esac

# tmux rejects '.' and ':' in session names; '/' is flattened for readability.
sanitize() { printf '%s' "$1" | tr '/:.' '---'; }

work_dir=${2:-$PWD}
[[ -d $work_dir ]] || die "no such directory: $work_dir"
cd "$work_dir"
work_dir=$PWD
session=$(sanitize "${1:-$(basename "$PWD")}")

notice=''
attach() {
    local cmd=attach-session
    [[ -z ${TMUX:-} ]] || cmd=switch-client
    if [[ -n $notice ]]; then
        printf 'dev-session: %s\n' "$notice" >&2
        exec tmux "$cmd" -t "=$session" \; display-message -d 5000 "$notice"
    fi
    exec tmux "$cmd" -t "=$session"
}

if tmux has-session -t "=$session" 2>/dev/null; then
    existing=$(tmux display-message -p -t "=$session:" '#{session_path}')
    [[ $existing == "$work_dir" ]] || notice="session $session is in $existing, not $work_dir"
    attach
fi

tmux new-session -d -s "$session" -n dev -c "$work_dir"
tmux split-window -h -t "=$session:dev" -c "$work_dir"
tmux send-keys -t "=$session:dev.{right}" claude C-m
tmux select-pane -t "=$session:dev.{left}"
attach
