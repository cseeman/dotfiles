#!/usr/bin/env bash
# Lists my open and draft PRs across an org, with review decision and CI state.
# Usage: my-prs [--raw] [org]   --raw prints the |-separated rows the my-prs skill parses.
set -euo pipefail
# shellcheck source=/dev/null
[[ -r ~/.pr-tools.local ]] && source ~/.pr-tools.local
raw=false
[[ ${1:-} == --raw ]] && { raw=true; shift; }
org="${1:-${PR_REREVIEW_ORG:-}}"
[[ -n $org ]] || { echo "my-prs: pass an org or set PR_REREVIEW_ORG in ~/.pr-tools.local" >&2; exit 1; }
extras="${PR_MINE_EXTRAS:-$HOME/.my-prs-extras}"

# One search query per run; a gh call per PR took 20+ seconds.
search() {
  # shellcheck disable=SC2016  # $q is a GraphQL variable
  gh api graphql -F q="$1" -f query='query($q:String!){search(query:$q,type:ISSUE,first:100){nodes{...on PullRequest{
    number title url isDraft updatedAt reviewDecision author{login} repository{name}
    commits(last:1){nodes{commit{statusCheckRollup{contexts(first:100){nodes{
      ...on CheckRun{conclusion status} ...on StatusContext{state}}}}}}}
  }}}}' --jq '.data.search.nodes[]' |
  jq -r --arg other "$2" '
    [.commits.nodes[0].commit.statusCheckRollup.contexts.nodes[]?
      | .conclusion // .state // "PENDING"
      | select(. != "SUCCESS" and . != "SKIPPED" and . != "NEUTRAL")] as $bad
    | [.repository.name, .number, (if .isDraft then "draft" else "open" end), .updatedAt[0:10],
       (if (.reviewDecision // "") == "" then "-" else .reviewDecision end),
       (if ($bad | length) == 0 then "green" else ($bad | group_by(.) | map("\(.[0]):\(length)") | join(" ")) end),
       (if $other == "" then .title else "\(.author.login): \(.title)" end), .url]
    | map(tostring) | join("|")'
}

rows() {
  printf 'repo|number|state|updated|review|ci|title|url\n'
  search "is:open is:pr author:@me org:$org archived:false" "" | sort -t'|' -k1,1 -k2,2n
  [[ -r $extras ]] || return 0
  # Someone else's PR, one "owner/repo#number" per line, listed while it stays open.
  { grep -vE '^\s*(#|$)' "$extras" || true; } | while IFS= read -r ref; do
    search "is:open is:pr repo:${ref%%#*} ${ref##*#}" other | awk -F'|' -v n="${ref##*#}" '$2 == n'
  done
}

# Grouped by repo with no URL column, so a row fits a split pane.
table() {
  awk -F'|' -v width="$(tput cols 2>/dev/null || echo 100)" '
    NR == 1 { next }
    {
      n++; repo[n] = $1; num[n] = "#" $2; state[n] = $3; ci[n] = tolower($6); title[n] = $7
      review[n] = $5 == "APPROVED" ? "approved" : $5 == "CHANGES_REQUESTED" ? "changes" : $5 == "-" ? "-" : "needs review"
      w1 = max(w1, length(num[n])); w2 = max(w2, length(state[n]))
      w3 = max(w3, length(review[n])); w4 = max(w4, length(ci[n]))
    }
    END {
      fmt = "  %-" w1 "s  %-" w2 "s  %-" w3 "s  %-" w4 "s  %s\n"
      room = width - (2 + w1 + 2 + w2 + 2 + w3 + 2 + w4 + 2)
      if (room < 20) room = 20
      for (i = 1; i <= n; i++) {
        if (repo[i] != repo[i - 1]) printf "%s%s\n", (i > 1 ? "\n" : ""), repo[i]
        t = length(title[i]) > room ? substr(title[i], 1, room - 3) "..." : title[i]
        printf fmt, num[i], state[i], review[i], ci[i], t
      }
    }
    function max(a, b) { return a > b ? a : b }'
}

if $raw; then rows; else rows | table; fi
