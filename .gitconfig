# ~/.gitconfig
[user]
	name = Christine Seeman
	email = christine.seeman@sofwarellc.com
	signingkey = F5BB5808BF773AFD1BFD0DB996A6EDD21120FC7E
[alias]
  st     = status
  d      = diff
  co     = checkout
  can    = commit --amend --no-edit
  cp     = cherry-pick
  dm     = diff main
  b      = branch
  prb    = pull --rebase
  pf     = push --force-with-lease
  pfu    = push --force-with-lease -u origin HEAD
  fo     = fetch origin
  ff     = merge --ff-only
  noff   = merge --no-ff
  nocom  = merge --no-commit
  rip    = rebase --interactive --rebase-merges
  l      = log --graph --oneline
  lb     = log --graph --oneline --branches
  ll     = log --stat
  lll    = log -p
  oops   = reset --keep HEAD~1
  up     = pull --rebase --autostash
  remotes = remote -v
  rhh = reset --hard HEAD
  rh = reset --hard
  stashes = stash list
  unstash = stash pop
  fixup = commit --fixup
  wup = log --pretty=format:'%h %cn %cr %s' --graph --since=10.weeks
  #Typical Spelling snafu
  checkou = checkout
  statsh = stash
  cop = !git add -N . && git diff --name-only --diff-filter=d -- '*.rb' '*.rake' | xargs rubocop
	conflicts = diff --name-only --diff-filter=U
	wt-status = !pwd && git branch --show-current && git status --short
  wlist = !git worktree list --porcelain | grep -A 2 "$(pwd)"
  ps = push origin HEAD
	recent-pager = !git branch --sort=-committerdate --format=\"%(committerdate:relative)%09%(refname:short)\" | less -FX
	# git recent [n] is bin/git-recent; these keep the old names working
	recents = !git-recent
	recent5 = !git-recent 5
	recent10 = !git-recent 10
	reword = commit --amend --only
[branch]
	sort = -committerdate
[column]
        ui = auto
[commit]
	gpgsign = true
	verbose = true
[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[fetch]
        prune = true
        pruneTags = true
        all = true
[help]
	autocorrect = prompt
[init]
	defaultBranch = main
[merge]
	conflictStyle = zdiff3
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[rerere]
	enabled = true
	autoUpdate = true
# Machine-specific settings (work identity, credential helpers). Later wins.
[include]
	path = ~/.gitconfig.local
