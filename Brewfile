# What the configs and scripts in this repo need. Install with: brew bundle
# Terminals are installed by hand: Homebrew disabled the Alacritty cask, and a
# cask fails the whole bundle when its app is already in /Applications.

# Shell
brew "bash"
brew "bash-completion@2"
brew "starship"
brew "fzf"
brew "fd"
brew "ripgrep"
brew "bat"       # fzf previews and a paging cat
brew "eza"       # ls with git status and tree
brew "zoxide"    # cd that learns
brew "mise"
brew "jq"
brew "shellcheck"  # make check
brew "overmind"

# Git
brew "git"
brew "gh"
brew "gnupg"
brew "pinentry-mac"
brew "gitleaks"  # hooks/pre-push
brew "lazygit"

# Terminal
brew "tmux"
brew "neovim"
brew "tree-sitter-cli"  # compiles nvim-treesitter parsers
brew "glow"
brew "go"          # vim-hexokinase builds its helper with Go
brew "zellij"
brew "tree"
brew "coreutils"

# Rails apps: databases, gem build deps, deploy tools
brew "postgresql@15"
brew "mysql"
brew "mysql-client"
brew "libpq"
brew "redis"
brew "libyaml"     # mise builds Ruby against it
brew "imagemagick"
brew "poppler"
brew "plantuml"
brew "rubyfmt"
brew "flyctl"
brew "cloudflared"
brew "wireguard-tools"
brew "pipx"
brew "mas"         # Brewfile.apps installs App Store apps

# Fonts used by the Alacritty configs
cask "font-jetbrains-mono-nerd-font"
cask "font-maple-mono-nf"
cask "font-monaspace-nf"
cask "font-meslo-lg-nerd-font"
