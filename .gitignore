# Vim temporary files
*.swp
*.swo
*~
.viminfo
.netrwhist

# macOS
.DS_Store

# Neovim plugin directories (managed by plugin managers)
.config/nvim/plugged/
.config/nvim/lazy-lock.json
.config/nvim/plugin/

# Old/backup files
*.old
*.backup
old_*
# Active theme state, written by switch-theme.sh
.config/tmux/config/theme.conf
.config/starship.toml
.config/glow/glow.yml

# tmux plugins are installed by tpm; resurrect holds saved sessions
.config/tmux/plugins/
.config/tmux/resurrect/
